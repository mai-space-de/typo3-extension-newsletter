plugin.tx_newsletter_subscription {
    view {
        templateRootPaths.0 = EXT:newsletter/Resources/Private/Templates/
        partialRootPaths.0 = EXT:newsletter/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:newsletter/Resources/Private/Layouts/
    }
    persistence {
        storagePid = {$plugin.tx_newsletter_subscription.persistence.storagePid}
    }
    settings {
        subscriberListUid = {$plugin.tx_newsletter_subscription.settings.subscriberListUid}
        confirmationPageUid = {$plugin.tx_newsletter_subscription.settings.confirmationPageUid}
    }
}

module.tx_newsletter {
    view {
        templateRootPaths.0 = EXT:newsletter/Resources/Private/Templates/
        partialRootPaths.0 = EXT:newsletter/Resources/Private/Partials/
        layoutRootPaths.0 = EXT:newsletter/Resources/Private/Layouts/
    }
}
